# ─── YouTube Data API v3 ──────────────────────────────────────────────────────
# Get yours at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=

# ─── Pinterest API v5 ─────────────────────────────────────────────────────────
# Get yours at: https://developers.pinterest.com/apps/
# Scope needed: pins:read, boards:read
PINTEREST_ACCESS_TOKEN=

# ─── NewsData.io ──────────────────────────────────────────────────────────────
# Get yours (free tier available) at: https://newsdata.io/register
NEWSDATA_API_KEY=

# ─── Reddit (public API — no key required) ────────────────────────────────────
# Reddit's public JSON API is used without authentication.
# For higher rate limits, register an app at: https://www.reddit.com/prefs/apps
# and supply credentials below (optional).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
